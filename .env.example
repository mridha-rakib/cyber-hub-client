# ---------------------------------------------------------------------------
# Public environment variables (exposed to the browser, must be prefixed
# with NEXT_PUBLIC_). Copy this file to `.env.local` and adjust the values.
# ---------------------------------------------------------------------------

# Base URL for the backend API consumed by the Axios instance. Must include
# the backend's global API prefix + version (currently `/api/v1`).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
